# Environnement de recette U2b strictement distinct de U0.
CABINET_PROJECT_NAME=cabinetcardio-test-u2
CABINET_API_PORT=8766
CABINET_MAINTENANCE_IMAGE=cabinet-maintenance:2026.09.16-u2b
CABINET_DATA_VOLUME=/volume1/CabinetCardioTestU2
CABINET_DB_VOLUME=/volume1/docker/cabinetcardio-test-u2/postgres
CABINET_BACKUP_VOLUME=/volume1/docker/cabinetcardio-test-u2/sauvegardes
CABINET_UNC=\\NAS-RECETTE\CabinetCardioTestU2
# Valeurs d'exemple : les remplacer par l'UID et le GID du compte de recette sur le NAS.
CABINET_UID=1000
CABINET_GID=1000
# Groupe dedie aux lecteurs d'archives ; vide = archives privees 0600.
CABINET_ARCHIVE_GID=
# Doit exister, etre prive et vide avant la restauration.
CABINET_RESTORE_CONFIG=/volume1/docker/cabinetcardio-test-u2/configuration-restauree
