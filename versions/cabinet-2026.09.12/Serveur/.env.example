# Modele volontairement non deployable : renseigner chaque cible apres sauvegarde.
# Pour la recette U2c, partir de .env.u2-test.example, pas de ce fichier.
CABINET_PROJECT_NAME=
CABINET_API_PORT=
CABINET_MAINTENANCE_IMAGE=cabinet-maintenance:2026.09.21-u2c
CABINET_DATA_VOLUME=
CABINET_DB_VOLUME=
CABINET_BACKUP_VOLUME=
CABINET_UNC=
CABINET_UID=
CABINET_GID=
# Groupe dedie aux lecteurs d'archives, a configurer/verifier dans DSM.
# Vide : conservation privee 0600. Ne pas attribuer un groupe general par defaut.
CABINET_ARCHIVE_GID=
# Seulement dans un nouveau projet de restauration : dossier vide prive.
CABINET_RESTORE_CONFIG=
